local function stopSprinting()
	ir = false
	isStaminaDepleted = false
	rb.ImageColor3 = stamina <= 0 and c3(100, 100, 100) or c3(255, 255, 255)
	local c = lp.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	if h and not (ca and ca.IsPlaying) then
		h.WalkSpeed = walkSpeedSetting
	end
end

local function startSprinting()
	if stamina <= 0 then
		isStaminaDepleted = true
		return
	end
	isStaminaDepleted = false
	ir = true
	rb.ImageColor3 = c3(0, 255, 100)
	local c = lp.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	if h and not (ca and ca.IsPlaying) then
		h.WalkSpeed = runSpeedSetting
	end
end

local function run()
	if stamina <= 0 then
		stopSprinting()
		return
	end
	ir = not ir
	if ir then
		rb.ImageColor3 = c3(0, 255, 100)
	else
		rb.ImageColor3 = c3(255, 255, 255)
	end
	local c = lp.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	if h and not (ca and ca.IsPlaying) then
		h.WalkSpeed = ir and runSpeedSetting or walkSpeedSetting
	end
end

local function toggleShiftLock()
	isSL = not isSL
	slb.ImageColor3 = isSL and c3(0, 200, 255) or c3(255, 255, 255)
end

