local function updateHealthBar()
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	local hp, max = hum.Health, hum.MaxHealth
	local pct = hp / max
	ts:Create(healthFill, TweenInfo.new(0.13, Enum.EasingStyle.Sine), {Size = ud2(pct, 0, 1, 0)}):Play()
	healthText.Text = math.floor(hp) .. "/" .. math.floor(max)
	if pct < 0.3 then
		healthFill.BackgroundColor3 = c3(255, 30, 30)
	else
		healthFill.BackgroundColor3 = c3(200, 50, 70)
	end
end

local function updateStaminaBar()
	local pct = stamina / MAX_STAMINA
	ts:Create(staminaFill, TweenInfo.new(0.13, Enum.EasingStyle.Sine), {Size = ud2(pct, 0, 1, 0)}):Play()
	staminaText.Text = math.floor(stamina) .. "/" .. MAX_STAMINA
	if pct < 0.15 then
		staminaFill.BackgroundColor3 = c3(255, 80, 80)
	else
		staminaFill.BackgroundColor3 = c3(210, 210, 210)
	end
end

local function checkLowHealth()
	if not lowHealthEnabled then
		if lowHealthActive then
			lowHealthActive = false
			LIVE.idle = savedLIVE.idle or IDS.I_ID
			LIVE.walk = savedLIVE.walk or IDS.W_ID
			LIVE.run = savedLIVE.run or IDS.R_ID
			savedLIVE = { idle = nil, walk = nil, run = nil }
			st = {}
		end
		return
	end

	local char = lp.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	local hp = hum.Health
	local maxHp = hum.MaxHealth
	local half = maxHp / 2

	if hp <= half and hp > 0 then
		if not lowHealthActive then
			lowHealthActive = true
			savedLIVE.idle = LIVE.idle
			savedLIVE.walk = LIVE.walk
			savedLIVE.run = LIVE.run
			local set = INJURED_SETS[activeInjuredSet]
			LIVE.idle = set.idle
			LIVE.walk = set.walk
			LIVE.run = set.run
			st = {}
		end
	elseif hp > half then
		if lowHealthActive then
			lowHealthActive = false
			LIVE.idle = savedLIVE.idle or IDS.I_ID
			LIVE.walk = savedLIVE.walk or IDS.W_ID
			LIVE.run = savedLIVE.run or IDS.R_ID
			savedLIVE = { idle = nil, walk = nil, run = nil }
			st = {}
		end
	end
end

local function main(c)
	local h = c:WaitForChild("Humanoid")
	if h.RigType == Enum.HumanoidRigType.R6 then
		sg.Enabled = false
		local oldWarn = lp.PlayerGui:FindFirstChild("R6Warning")
		if oldWarn then oldWarn:Destroy() end
		local wGui = ins("ScreenGui")
		wGui.Name = "R6Warning"
		wGui.Parent = lp:WaitForChild("PlayerGui")
		local wBg = ins("Frame")
		wBg.Size = ud2(0, 300, 0, 75)
		wBg.Position = ud2(0.5, 0, 0.15, 0)
		wBg.AnchorPoint = v2(0.5, 0.5)
		wBg.BackgroundColor3 = c3(15, 15, 15)
		wBg.BorderSizePixel = 0
		wBg.Parent = wGui
		local wTxt = ins("TextLabel")
		wTxt.Size = ud2(1, 0, 1, 0)
		wTxt.BackgroundTransparency = 1
		wTxt.Text = "R15 REQUIRED. R6 IS NOT SUPPORTED."
		wTxt.TextColor3 = c3(255, 50, 50)
		wTxt.Font = Enum.Font.SourceSansBold
		wTxt.TextSize = 18
		wTxt.Parent = wBg
		task.spawn(function()
			task.wait(3)
			local tInfo = TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			local tweenBg = ts:Create(wBg, tInfo, {BackgroundTransparency = 1})
			local tweenTxt = ts:Create(wTxt, tInfo, {TextTransparency = 1})
			tweenBg:Play()
			tweenTxt:Play()
			tweenTxt.Completed:Wait()
			wGui:Destroy()
		end)
		return
	else
		sg.Enabled = true
		local oldWarn = lp.PlayerGui:FindFirstChild("R6Warning")
		if oldWarn then oldWarn:Destroy() end
	end

	local a = h:WaitForChild("Animator")

	for _, o in ipairs(c:GetDescendants()) do
		if o:IsA("Script") and o.Name == "Animate" then
			o.Disabled = true
			break
		end
	end

	for _, t in ipairs(a:GetPlayingAnimationTracks()) do t:Stop(0) end
	for _, t in ipairs(h:GetPlayingAnimationTracks()) do t:Stop(0) end

	h.JumpPower = 0
	h:SetStateEnabled(Enum.HumanoidStateType.Seated, false)

	st, ca, isMovingEmote = {}, nil, false
	stamina = MAX_STAMINA
	staminaRegenDelay = 0
	staminaDepletedDelay = 0
	isStaminaDepleted = false

	local it = loadAnim(a, LIVE.idle)
	it.Priority = Enum.AnimationPriority.Idle
	it:Play(0.25)
	st.idle = it

	local headAnim = ins("Animation")
	headAnim.AnimationId = IDS.H_ID
	local headTrack = a:LoadAnimation(headAnim)
	headTrackRef = headTrack
	headTrack.Priority = Enum.AnimationPriority.Action4
	headTrack:Play(0, 1, 0)
	headTrack:AdjustWeight(0.2)

	updateFaceAnimation(false, a)

	local currentYaw = 0
	local targetYaw = 0
	local yawVelocity = 0
	local yawAccel = 0
	local prevTargetYaw = 0

	if renderConn then renderConn:Disconnect() end
	if healthCheckConnection then
		task.cancel(healthCheckConnection)
		healthCheckConnection = nil
	end

	healthCheckConnection = task.spawn(function()
		while active and lp.Character do
			task.wait(0.5)
			checkLowHealth()
		end
	end)

	renderConn = rs.RenderStepped:Connect(function(dt)
		if not active or not c or not c.Parent then
			if renderConn then renderConn:Disconnect() end
			renderConn = nil
			return
		end

		upd(c, h, a)

		local isMoving = h.MoveDirection.Magnitude > 0
		if staminaEnabled then
			if ir and isMoving then
				stamina = stamina - drainRate * dt
				staminaRegenDelay = 0
				if stamina <= 0 then
					stamina = 0
					staminaDepletedDelay = staminaDepletedDelay + dt
					if ir then
						stopSprinting()
					end
				end
			else
				staminaDepletedDelay = 0
				if stamina < MAX_STAMINA then
					staminaRegenDelay = staminaRegenDelay + dt
					if staminaRegenDelay >= regenDelay then
						stamina = math.min(stamina + regenRate * dt, MAX_STAMINA)
					end
				end
			end
		else
			stamina = MAX_STAMINA
		end

		updateStaminaBar()
		updateHealthBar()

		if stamina <= 0 then
			rb.ImageColor3 = c3(100, 100, 100)
		elseif ir then
			rb.ImageColor3 = c3(0, 255, 100)
		else
			rb.ImageColor3 = c3(255, 255, 255)
		end

		local isEmoting = ca and ca.IsPlaying
		if headCamMode == 1 then
			headCamEnabled = isEmoting
		elseif headCamMode == 2 then
			headCamEnabled = not isEmoting
		elseif headCamMode == 3 then
			headCamEnabled = true
		else
			headCamEnabled = false
		end

		if headCamEnabled then
			local head = c:FindFirstChild("Head")
			if head then
				local hrp = c:FindFirstChild("HumanoidRootPart")
				if hrp then
					local headPos = (hrp.CFrame + v3(0, 1.5, 0)):PointToObjectSpace(head.Position)
					h.CameraOffset = h.CameraOffset:Lerp(headPos, math.min(dt * 5, 1))
				end
			end
		else
			h.CameraOffset = h.CameraOffset:Lerp(v3(0, 0, 0), math.min(dt * 5, 1))
		end

		local rp = c:FindFirstChild("HumanoidRootPart")
		if rp and h then
			local moveDir = h.MoveDirection
			local targetFov = 70
			if ir and moveDir.Magnitude > 0 then
				targetFov = 80
			end
			camera.FieldOfView = camera.FieldOfView + (targetFov - camera.FieldOfView) * math.min(dt * 2, 1)

			if isSL then
				local camLook = camera.CFrame.LookVector
				local targetCF = CFrame.lookAt(rp.Position, rp.Position + v3(camLook.X, 0, camLook.Z))
				rp.CFrame = rp.CFrame:Lerp(targetCF, 0.5)
			elseif moveDir.Magnitude > 0 then
				local targetCF = CFrame.lookAt(rp.Position, rp.Position + moveDir)
				rp.CFrame = rp.CFrame:Lerp(targetCF, 0.1)
			end

			if isMovingEmote then
				h:Move(rp.CFrame.LookVector)
			end

			if not (ca and ca.IsPlaying) then
				local camDirObjSpace = rp.CFrame:VectorToObjectSpace(camera.CFrame.LookVector)
				targetYaw = -math.atan2(camDirObjSpace.X, -camDirObjSpace.Z)
				local maxRotation = math.rad(75)
				targetYaw = math.clamp(targetYaw, -maxRotation, maxRotation)
				local targetDelta = targetYaw - prevTargetYaw
				prevTargetYaw = targetYaw
				local delta = targetYaw - currentYaw
				local k = 12
				local d = 0.92
				local pred = targetDelta * 8
				yawAccel = yawAccel + (delta + pred) * k * dt
				yawAccel = yawAccel * d
				yawVelocity = yawVelocity + yawAccel * dt
				yawVelocity = yawVelocity * 0.98
				currentYaw = currentYaw + yawVelocity * dt
				currentYaw = currentYaw + (targetYaw - currentYaw) * math.min(dt * 3, 0.15)
				local yawMapped = currentYaw
				if yawMapped < 0 then
					yawMapped = yawMapped + (math.pi * 2)
				end
				if headTrack.Length > 0 then
					headTrack.TimePosition = (yawMapped / (math.pi * 2)) * headTrack.Length
				end
			end
		end
	end)
end

local function watchForAnimate(c)
	local conn = c.DescendantAdded:Connect(function(d)
		if d:IsA("Script") and d.Name == "Animate" then
			d.Disabled = true
		end
	end)
	table.insert(animateConns, conn)
	for _, o in ipairs(c:GetDescendants()) do
		if o:IsA("Script") and o.Name == "Animate" then
			o.Disabled = true
		end
	end
end

charAddedConn = lp.CharacterAdded:Connect(function(c)
	watchForAnimate(c)
	main(c)
end)

if lp.Character then
	watchForAnimate(lp.Character)
	task.spawn(main, lp.Character)
end
