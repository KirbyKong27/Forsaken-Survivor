local function clearCa()
	stop_a()
	isMovingEmote = false
	stopE.Visible = false
	local c = lp.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	local a = h and h:FindFirstChildOfClass("Animator")
	if h then
		h.WalkSpeed = ir and runSpeedSetting or walkSpeedSetting
		h.JumpPower = 0
	end
	if a then
		updateFaceAnimation(false, a)
	end
	if idleVariantTimer then
		task.cancel(idleVariantTimer)
		idleVariantTimer = nil
	end
	if idleVariantTrack then
		idleVariantTrack:Stop(0.25)
		idleVariantTrack = nil
	end
end

