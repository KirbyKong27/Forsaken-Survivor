-- ============================================================
local function playEmoteWithVariations(animId, variations, interval, isCar)
	local c = lp.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	local a = h and h:FindFirstChildOfClass("Animator")
	if not a then return end
	clearCa()
	ef.Visible = false
	stop_s(a)
	local emoteId = animId
	if variations and #variations > 0 then
		emoteId = variations[math.random(1, #variations)]
	end
	local t = loadAnim(a, emoteId)
	ca = t
	t.Looped = true
	t.Priority = Enum.AnimationPriority.Action3
	if isCar then
		isMovingEmote = true
		h.WalkSpeed = 8
		currentVariation = emoteId
		if variationTimer then task.cancel(variationTimer) end
		variationTimer = task.spawn(function()
			while ca == t and t.IsPlaying do
				task.wait(interval or 4)
				if ca == t and t.IsPlaying and a then
					local newId = variations[math.random(1, #variations)]
					if newId ~= currentVariation then
						local newTrack = loadAnim(a, newId)
						newTrack.Looped = true
						newTrack.Priority = Enum.AnimationPriority.Action3
						newTrack:Play(0.25)
						t:Stop(0.25)
						ca = newTrack
						t = newTrack
						currentVariation = newId
					end
				end
			end
		end)
	else
		isMovingEmote = false
		h.WalkSpeed = 0
	end
	t:Play(0.25)
	stopE.Visible = true
	updateFaceAnimation(true, a)
	if currentEmoteThread then task.cancel(currentEmoteThread) end
	currentEmoteThread = task.spawn(function()
		while ca == t and t.IsPlaying do
			stop_s(a)
			task.wait(0.1)
		end
	end)
end

