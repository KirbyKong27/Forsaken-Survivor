		btn.TextSize = 15
		btn.Parent = frame

		btn.MouseButton1Click:Connect(function()
			activeAnims[slot] = idx
			LIVE[slot] = entry.id
			st = {}
			for _, child in ipairs(frame:GetChildren()) do
				if child:IsA("TextButton") then
					local name = child.Text:gsub(" ✓", "")
					local isActive = activeAnims[slot] == idx and name == entry.name
					child.Text = name .. (isActive and " ✓" or "")
					child.TextColor3 = isActive and c3(0, 200, 255) or c3(200, 200, 200)
				end
			end
		end)
	end

	return frame
end

