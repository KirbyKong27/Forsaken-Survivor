-- ============================================================
-- ANIMATION HELPER FUNCTIONS (unchanged)
-- ============================================================
local function stop_s(a)
	for _, t in ipairs(a:GetPlayingAnimationTracks()) do
		if t ~= headTrackRef and t ~= ca and t ~= faceTrackRef then
			t:Stop(0.25)
		end
	end
end

local function stop_a()
	if ca then
		ca:Stop(0.25)
		ca = nil
	end
	if variationTimer then
		task.cancel(variationTimer)
		variationTimer = nil
	end
	if currentEmoteThread then
		task.cancel(currentEmoteThread)
		currentEmoteThread = nil
	end
	currentVariation = nil
	isMovingEmote = false
end

local function loadAnim(a, id)
	local anim = ins("Animation")
	anim.AnimationId = id
	return a:LoadAnimation(anim)
end

local function updateFaceAnimation(isEmoting, a)
	if not a then return end
	if isEmoting then
		if faceTrackRef and faceTrackRef.Animation.AnimationId == IDS.FACE_IDLE_ID then
			faceTrackRef:AdjustWeight(0)
			faceTrackRef = nil
		end
		if not faceTrackRef or faceTrackRef.Animation.AnimationId ~= IDS.FACE_EMOTE_ID then
			local faceAnim = ins("Animation")
			faceAnim.AnimationId = IDS.FACE_EMOTE_ID
			faceTrackRef = a:LoadAnimation(faceAnim)
			faceTrackRef.Priority = Enum.AnimationPriority.Action4
			faceTrackRef.Looped = true
			faceTrackRef:Play(0.25)
		end
	else
		if faceTrackRef and faceTrackRef.Animation.AnimationId == IDS.FACE_EMOTE_ID then
			faceTrackRef:AdjustWeight(0)
			faceTrackRef = nil
		end
		if not faceTrackRef or faceTrackRef.Animation.AnimationId ~= IDS.FACE_IDLE_ID then
			local faceAnim = ins("Animation")
			faceAnim.AnimationId = IDS.FACE_IDLE_ID
			faceTrackRef = a:LoadAnimation(faceAnim)
			faceTrackRef.Priority = Enum.AnimationPriority.Action4
			faceTrackRef.Looped = true
			faceTrackRef:Play(0.25)
		end
	end
end

